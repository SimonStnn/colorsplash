    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Colorsplash API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "flask",
            "args": [
                "--app",
                "${workspaceFolder}/api/index.py",
                "--debug",
                "run"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}